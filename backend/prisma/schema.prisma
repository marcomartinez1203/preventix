// Preventix - Prisma Schema
// Base de datos: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Rol {
  administrador
  responsable
  tecnico
  consulta
}

enum TipoEquipo {
  desktop
  laptop
  servidor
  otro
}

enum EstadoEquipo {
  activo
  en_mantenimiento
  fuera_servicio
  archivado
}

enum CategoriaFalla {
  hardware
  software
  red
  perifericos
  otro
}

enum PrioridadFalla {
  baja
  media
  alta
  critica
}

enum EstadoFalla {
  abierta
  en_proceso
  resuelta
  cerrada
}

enum TipoMantenimiento {
  preventivo
  correctivo
}

enum EstadoMantenimiento {
  programado
  en_proceso
  completado
  cancelado
  vencido
}

enum TipoAlerta {
  proximo
  vencido
  recordatorio
}

enum CanalAlerta {
  interna
  email
  ambas
}

// ─────────────────────────────────────────────
// PLAN DE SUSCRIPCIÓN
// ─────────────────────────────────────────────

model Plan {
  id              String    @id @default(uuid())
  nombre          String    @db.VarChar(50)
  maxEquipos      Int
  maxSedes        Int       @default(1)
  maxUsuarios     Int       @default(5)
  precioMensual   Decimal   @db.Decimal(10, 2) @default(0)
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  empresas        Empresa[]

  @@map("planes")
}

// ─────────────────────────────────────────────
// EMPRESA (TENANT)
// ─────────────────────────────────────────────

model Empresa {
  id              String    @id @default(uuid())
  nombre          String    @db.VarChar(150)
  nit             String?   @db.VarChar(30)
  emailContacto   String    @db.VarChar(150)
  telefono        String?   @db.VarChar(20)
  logoUrl         String?
  planId          String
  activa          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  plan            Plan      @relation(fields: [planId], references: [id])
  configuracion   ConfiguracionEmpresa?
  sedes           Sede[]
  usuarios        Usuario[]
  equipos         Equipo[]
  fallas          Falla[]
  mantenimientos  Mantenimiento[]
  notificaciones  Notificacion[]
  alertas         AlertaMantenimiento[]

  @@map("empresas")
}

// ─────────────────────────────────────────────
// CONFIGURACIÓN DE EMPRESA
// ─────────────────────────────────────────────

model ConfiguracionEmpresa {
  id                       String   @id @default(uuid())
  empresaId                String   @unique
  notifEmail               Boolean  @default(true)
  diasAvisoMantenimiento   Int      @default(7)
  zonaHoraria              String   @default("America/Bogota") @db.VarChar(50)
  moneda                   String   @default("COP") @db.VarChar(10)
  updatedAt                DateTime @updatedAt

  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("configuracion_empresa")
}

// ─────────────────────────────────────────────
// SEDE
// ─────────────────────────────────────────────

model Sede {
  id          String   @id @default(uuid())
  empresaId   String
  nombre      String   @db.VarChar(100)
  direccion   String?
  ciudad      String?  @db.VarChar(100)
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ubicaciones Ubicacion[]
  equipos     Equipo[]

  @@map("sedes")
}

// ─────────────────────────────────────────────
// UBICACIÓN (dentro de una sede)
// ─────────────────────────────────────────────

model Ubicacion {
  id          String  @id @default(uuid())
  sedeId      String
  nombre      String  @db.VarChar(100)
  descripcion String?

  sede    Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  equipos Equipo[]

  @@map("ubicaciones")
}

// ─────────────────────────────────────────────
// USUARIO
// ─────────────────────────────────────────────

model Usuario {
  id                 String    @id @default(uuid())
  empresaId          String
  nombre             String    @db.VarChar(100)
  email              String    @unique @db.VarChar(150)
  passwordHash       String
  rol                Rol       @default(consulta)
  esTecnicoExterno   Boolean   @default(false)
  activo             Boolean   @default(true)
  ultimoAcceso       DateTime?
  refreshToken       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  empresa              Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  equiposAsignados     Equipo[]             @relation("EquipoUsuarioAsignado")
  equiposResponsable   Equipo[]             @relation("EquipoResponsable")
  fallasReportadas     Falla[]              @relation("FallaReportadaPor")
  fallasAsignadas      Falla[]              @relation("FallaAsignadaA")
  mantenimientosResp   Mantenimiento[]
  notificaciones       Notificacion[]
  historialAcciones    HistorialEquipo[]
  tecnicoEmpresas      TecnicoEmpresa[]     @relation("TecnicoUsuario")
  autorizacionesDadas  TecnicoEmpresa[]     @relation("TecnicoAutorizadoPor")

  @@map("usuarios")
}

// ─────────────────────────────────────────────
// TÉCNICO EXTERNO EN EMPRESA
// ─────────────────────────────────────────────

model TecnicoEmpresa {
  id             String   @id @default(uuid())
  tecnicoId      String
  empresaId      String
  autorizadoPor  String
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  tecnico       Usuario @relation("TecnicoUsuario", fields: [tecnicoId], references: [id])
  autorizador   Usuario @relation("TecnicoAutorizadoPor", fields: [autorizadoPor], references: [id])

  @@unique([tecnicoId, empresaId])
  @@map("tecnico_empresa")
}

// ─────────────────────────────────────────────
// EQUIPO
// ─────────────────────────────────────────────

model Equipo {
  id                  String       @id @default(uuid())
  empresaId           String
  sedeId              String?
  ubicacionId         String?
  usuarioAsignadoId   String?
  responsableId       String?
  nombre              String       @db.VarChar(150)
  tipo                TipoEquipo   @default(desktop)
  marca               String?      @db.VarChar(100)
  modelo              String?      @db.VarChar(100)
  numeroSerie         String?      @db.VarChar(100)
  procesador          String?      @db.VarChar(150)
  ramGb               Int?
  almacenamientoGb    Int?
  sistemaOperativo    String?      @db.VarChar(100)
  fechaAdquisicion    DateTime?    @db.Date
  estado              EstadoEquipo @default(activo)
  imagenUrl           String?
  notas               String?
  archivado           Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  empresa          Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sede             Sede?            @relation(fields: [sedeId], references: [id])
  ubicacion        Ubicacion?       @relation(fields: [ubicacionId], references: [id])
  usuarioAsignado  Usuario?         @relation("EquipoUsuarioAsignado", fields: [usuarioAsignadoId], references: [id])
  responsable      Usuario?         @relation("EquipoResponsable", fields: [responsableId], references: [id])
  fallas           Falla[]
  mantenimientos   Mantenimiento[]
  historial        HistorialEquipo[]

  @@map("equipos")
}

// ─────────────────────────────────────────────
// FALLA / INCIDENCIA
// ─────────────────────────────────────────────

model Falla {
  id                String         @id @default(uuid())
  equipoId          String
  empresaId         String
  reportadoPor      String
  asignadoA         String?
  titulo            String         @db.VarChar(200)
  descripcion       String
  categoria         CategoriaFalla @default(otro)
  prioridad         PrioridadFalla @default(media)
  estado            EstadoFalla    @default(abierta)
  diagnostico       String?
  solucionAplicada  String?
  fechaReporte      DateTime       @default(now())
  fechaResolucion   DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  equipo          Equipo          @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  empresa         Empresa         @relation(fields: [empresaId], references: [id])
  reportador      Usuario         @relation("FallaReportadaPor", fields: [reportadoPor], references: [id])
  tecnico         Usuario?        @relation("FallaAsignadaA", fields: [asignadoA], references: [id])
  mantenimientos  Mantenimiento[]

  @@map("fallas")
}

// ─────────────────────────────────────────────
// MANTENIMIENTO
// ─────────────────────────────────────────────

model Mantenimiento {
  id               String              @id @default(uuid())
  equipoId         String
  empresaId        String
  fallaId          String?
  responsableId    String
  tipo             TipoMantenimiento   @default(preventivo)
  estado           EstadoMantenimiento @default(programado)
  titulo           String              @db.VarChar(200)
  actividades      String?
  observaciones    String?
  costo            Decimal?            @db.Decimal(12, 2)
  fechaProgramada  DateTime            @db.Date
  fechaInicio      DateTime?
  fechaFin         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  equipo       Equipo                @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  empresa      Empresa               @relation(fields: [empresaId], references: [id])
  falla        Falla?                @relation(fields: [fallaId], references: [id])
  responsable  Usuario               @relation(fields: [responsableId], references: [id])
  alertas      AlertaMantenimiento[]

  @@map("mantenimientos")
}

// ─────────────────────────────────────────────
// ALERTA DE MANTENIMIENTO
// ─────────────────────────────────────────────

model AlertaMantenimiento {
  id                String      @id @default(uuid())
  mantenimientoId   String
  empresaId         String
  tipo              TipoAlerta
  diasAnticipacion  Int         @default(0)
  enviada           Boolean     @default(false)
  fechaEnvio        DateTime?
  canal             CanalAlerta @default(interna)
  createdAt         DateTime    @default(now())

  mantenimiento  Mantenimiento @relation(fields: [mantenimientoId], references: [id], onDelete: Cascade)
  empresa        Empresa       @relation(fields: [empresaId], references: [id])

  @@map("alertas_mantenimiento")
}

// ─────────────────────────────────────────────
// NOTIFICACIÓN IN-APP
// ─────────────────────────────────────────────

model Notificacion {
  id              String   @id @default(uuid())
  usuarioId       String
  empresaId       String
  tipo            String   @db.VarChar(50)
  titulo          String   @db.VarChar(200)
  mensaje         String
  leida           Boolean  @default(false)
  referenciaId    String?
  referenciaTipo  String?  @db.VarChar(50)
  createdAt       DateTime @default(now())

  usuario  Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa  Empresa @relation(fields: [empresaId], references: [id])

  @@map("notificaciones")
}

// ─────────────────────────────────────────────
// HISTORIAL DEL EQUIPO (log de cambios)
// ─────────────────────────────────────────────

model HistorialEquipo {
  id          String   @id @default(uuid())
  equipoId    String
  usuarioId   String
  tipoEvento  String   @db.VarChar(50)
  descripcion String
  metadata    Json?
  createdAt   DateTime @default(now())

  equipo  Equipo  @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("historial_equipos")
}
