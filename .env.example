# Sustentación: activo por defecto en desarrollo, sin PostgreSQL.
DEMO_MODE=true

# Configuración opcional para el backend original con DEMO_MODE=false
# Backend
DATABASE_URL="postgresql://user:password@localhost:5432/preventix"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Preventix <noreply@preventix.app>"

# Supabase Storage (opcional)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="xxxx"

# Solo en el panel de Vercel: conectar Blob PRIVATE para generar BLOB_READ_WRITE_TOKEN.
# JWT_SECRET debe ser aleatorio y tener al menos 32 caracteres.
# DEMO_BLOB_PATH=preventix/production/demo.json (opcional)
